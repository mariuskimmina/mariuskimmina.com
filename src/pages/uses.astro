---
import BaseLayout from '../layouts/BaseLayout.astro';

const groups = [
  {
    title: 'Browsing',
    items: [{ name: 'Zen Browser', url: 'https://zen-browser.app/' }],
  },
  {
    title: 'Terminal',
    items: [
      { name: 'Ghostty', url: 'https://ghostty.org/' },
      { name: 'Zellij', url: 'https://zellij.dev/' },
    ],
  },
  {
    title: 'Writing & notes',
    items: [{ name: 'Obsidian', url: 'https://obsidian.md/' }],
  },
  {
    title: 'System',
    items: [
      { name: 'NixOS', url: 'https://nixos.org/' },
      { name: 'Niri', url: 'https://github.com/niri-wm/niri' },
    ],
  },
  {
    title: 'Hosting',
    items: [
      { name: 'Hetzner', url: 'https://www.hetzner.com/' },
      { name: 'Railway', url: 'https://railway.com/' },
    ],
  },
  {
    title: 'AI tools',
    items: [{ name: 'Pi', url: 'https://github.com/earendil-works/pi' }],
  },
];
---

<BaseLayout title="Uses — Marius Kimmina" description="The software and hardware Marius uses." path="/uses/">
  <section class="page-shell page-intro uses-intro">
    <h1>Uses</h1>
    <p>A slowly growing inventory of the things I use</p>
  </section>
  <section class="page-shell uses-list">
    {groups.map((group) => (
      <section class="uses-group">
        <h2>{group.title}</h2>
        <ul>{group.items.map((item) => <li><a href={item.url}>{item.name}</a></li>)}</ul>
      </section>
    ))}
  </section>
</BaseLayout>
