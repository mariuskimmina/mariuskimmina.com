---
import BaseLayout from '../layouts/BaseLayout.astro';
import ActivityGrid from '../components/ActivityGrid.astro';
import WritingList from '../components/WritingList.astro';
import BookShelf from '../components/BookShelf.astro';
import data from '../data/atproto.json';

const recent = data.activity.filter((item) => !item.collection.startsWith('id.sifa.') && item.url).slice(0, 4);
const currentlyReading = data.books.filter((book) => !book.status || book.status.endsWith('#reading'));
const recentlyRead = data.books
  .filter((book) => book.status?.endsWith('#finished'))
  .sort((a, b) => (b.finishedAt || '').localeCompare(a.finishedAt || ''))
  .slice(0, Math.max(0, 5 - currentlyReading.length));
const homepageBooks = [...currentlyReading, ...recentlyRead];

function sourceClass(app: string) { return app.toLowerCase().replace(/[^a-z0-9]+/g, '-'); }
---

<BaseLayout>
  <section class="hero page-shell">
    <div class="hero-copy">
      <h1 class="hero-topic-title">I talk about running systems at scale, open source, clouds, self-hosting and <em><a href="https://atproto.com/">ATProto</a></em>.</h1>
      <p class="hero-lede">I also like to learn languages and play a lot of padel without being particularly good at it.</p>
      <div class="hero-actions">
        <a class="button-primary" href="#writing">Read my writing <span aria-hidden="true">↓</span></a>
        <a class="text-link" href="https://bsky.app/profile/mariuskimmina.com">Follow on Bluesky <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <div class="hero-portrait">
      <div class="portrait-frame"><img src="/images/profile.jpg" alt="Portrait of Marius Kimmina" width="640" height="640" /></div>
    </div>
  </section>

  <section class="intro-strip">
    <div class="page-shell intro-grid">
      <p class="intro-big">I run large-scale systems in the cloud for a living. I self-host small ones for fun.</p>
      <div class="intro-note">
        <span class="hand-arrow" aria-hidden="true">↳</span>
        <p>Currently a Senior DevOps Engineer<br />at adjoe.</p>
        <a href="/work/">Find my résumé here →</a>
      </div>
    </div>
  </section>

  <div class="page-shell">
    <ActivityGrid activity={data.activity} />

    <section class="recent-signal" aria-labelledby="recent-title">
      <div class="section-heading compact-heading">
        <div>
          <h2 id="recent-title">Recent signals</h2>
        </div>
      </div>
      <div class="signal-list">
        {recent.map((item) => (
          <a href={item.url} class="signal-row">
            <span class={`signal-source source-${sourceClass(item.app)}`}>{item.app.slice(0, 1)}</span>
            <span class="signal-copy"><strong>{item.label}</strong>{item.text && <small>{item.text}</small>}</span>
            <time datetime={item.date}>{new Date(item.date).toLocaleDateString('en', { month: 'short', day: 'numeric' })}</time>
            <span aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </section>

    <section id="writing" class="writing-section" aria-labelledby="writing-title">
      <div class="section-heading">
        <div>
          <h2 id="writing-title">Latest writing</h2>
        </div>
        <a class="text-link" href="/writing/">Everything I’ve written →</a>
      </div>
      <WritingList items={data.writing} limit={4} />
    </section>
  </div>

  <section class="reading-section">
    <div class="page-shell reading-grid">
      <div class="reading-intro">
        <h2>Recently in<br />my BookHive</h2>
        <p>What I’ve been reading lately.</p>
        <a class="text-link" href="/books/">Browse the whole shelf →</a>
      </div>
      <BookShelf books={homepageBooks} />
    </div>
  </section>

</BaseLayout>
