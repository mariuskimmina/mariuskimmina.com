---
import BaseLayout from '../layouts/BaseLayout.astro';

const methods = [
  {
    label: 'Email',
    value: 'marius.kimmina@proton.me',
    href: 'mailto:marius.kimmina@proton.me',
    note: '',
  },
  {
    label: 'LinkedIn',
    value: 'linkedin.com/in/marius-kimmina',
    href: 'https://www.linkedin.com/in/marius-kimmina/',
    note: 'if you have to',
  },
  {
    label: 'Bluesky',
    value: '@mariuskimmina.com',
    href: 'https://bsky.app/profile/mariuskimmina.com',
    note: 'DMs are open',
  },
];
---

<BaseLayout title="Contact — Marius Kimmina" description="Get in touch with Marius Kimmina." path="/contact/">
  <section class="contact-page page-shell">
    <header class="contact-intro">
      <h1>Contact</h1>
      <p>I’m always open to discussing new projects, creative ideas, or opportunities.</p>
    </header>

    <section class="contact-details" aria-labelledby="contact-details-title">
      <h2 id="contact-details-title">Get in touch</h2>
      <div class="contact-methods">
        {methods.map((method) => (
          <a class="contact-method" href={method.href}>
            <span>{method.label}</span>
            <strong>{method.value}</strong>
            {method.note && <small>{method.note}</small>}
            <span aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </section>
  </section>
</BaseLayout>
