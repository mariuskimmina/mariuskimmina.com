---
import BaseLayout from '../layouts/BaseLayout.astro';
import WritingList from '../components/WritingList.astro';
import data from '../data/atproto.json';
---

<BaseLayout description="Things I write about systems, open source, clouds, self-hosting, and ATProto." path="/writing/">
  <section class="page-shell page-intro">
    <h1>Writing</h1>
    <p>Notes about infrastructure, open protocols, learning, and whatever has been rattling around the toolbox.</p>
  </section>
  <section class="page-shell writing-archive" aria-label="All writing">
    <WritingList items={data.writing} />
  </section>
</BaseLayout>
